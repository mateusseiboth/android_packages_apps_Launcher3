<!-- The desktop of a PC (desktop form factor): its files, its menus and the apps sent to it. -->
<resources>
    <!-- Menu item of an app wherever apps are listed: puts the app on the desktop. [CHAR LIMIT=40] -->
    <string name="send_to_desktop_label">Send to desktop</string>
    <!-- Menu item of an app on the desktop: takes it off the desktop. [CHAR LIMIT=40] -->
    <string name="remove_from_desktop_label">Remove from desktop</string>
    <!-- Menu item of a file on the desktop: lists the apps that open it. [CHAR LIMIT=30] -->
    <string name="desktop_files_open_with_label">Open with</string>
    <!-- Menu item of a file on the desktop: puts it aside to be moved with Paste. [CHAR LIMIT=30] -->
    <string name="desktop_files_cut_label">Cut</string>
    <!-- Menu item of a file on the desktop: opens the Files app at the desktop folder. [CHAR LIMIT=40] -->
    <string name="desktop_files_show_in_files_label">Show in Files</string>
    <!-- Menu item of the empty desktop: brings the copied or cut files here. [CHAR LIMIT=30] -->
    <string name="desktop_paste_label">Paste</string>
    <!-- Menu item of the empty desktop: lines the icons up from the top, by name. [CHAR LIMIT=30] -->
    <string name="desktop_arrange_label">Arrange by name</string>
    <!-- Menu item of the empty desktop: opens the wallpaper picker. [CHAR LIMIT=40] -->
    <string name="desktop_change_wallpaper_label">Change wallpaper</string>
    <!-- Message when files could not be pasted on the desktop. [CHAR LIMIT=80] -->
    <string name="desktop_paste_failed">Some items could not be pasted. Try again.</string>
    <!-- Message when no app opens a file on the desktop. [CHAR LIMIT=80] -->
    <string name="desktop_files_no_app">No app opens this file.</string>
</resources>
